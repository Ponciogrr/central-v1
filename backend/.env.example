# API da Central de Motoboys — variáveis de ambiente (MODELO)
# Copie este arquivo para ".env" e preencha os valores.
# NÃO coloque segredos reais neste arquivo — ele vai para o repositório.

# Porta em que a API vai responder (padrão: 3000)
PORT=3000

# Ambiente de execução: development | production
NODE_ENV=development

# Banco de dados PostgreSQL (Neon).
# Ainda NÃO preenchido: crie o banco no Neon e cole aqui a URL de conexão completa,
# algo como postgresql://usuario:senha@host/banco?sslmode=require
# Enquanto estiver vazio, a API sobe normalmente e informa que o banco não está configurado.
DATABASE_URL=

# Conexão DIRETA do Neon (sem pooler), usada apenas pelas migrações (`npm run migrate`).
# No painel do Neon, copie a URL "Direct connection". Se ficar vazia, as migrações
# tentam usar DATABASE_URL.
DIRECT_URL=

# ---------------------------------------------------------------------------
# SEGREDOS DA AUTENTICAÇÃO (obrigatórios para o login funcionar).
# Gere valores fortes e privados, por exemplo:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# NÃO use estes campos vazios em produção e NÃO use valores fracos/padrão.
# Sem os dois campos, /health continua funcionando, mas o login responde 503.
CODE_HMAC_KEY=
JWT_SECRET=

# Validade do token de sessão (ex.: 7d, 12h). Padrão: 7d
JWT_EXPIRES_IN=7d

# Origens permitidas para CORS (Expo web em desenvolvimento + painel admin web),
# separadas por vírgula. Requisições do app nativo não usam Origin e não são afetadas.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
