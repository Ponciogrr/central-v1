{
  "name": "central-de-motoboys-api",
  "private": true,
  "version": "0.1.0",
  "description": "API da Central de Motoboys (Node.js + TypeScript + Express + PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env src/scripts/criar-admin.ts",
    "build": "esbuild api/_entrada.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=api/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
